    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #07111f;
            color: #f5f7fa;
            line-height: 1.6;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        /* NAVBAR */

        nav {
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 1000;
            background: rgba(7, 17, 31, 0.92);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

        .nav-container {
            max-width: 1150px;
            margin: auto;
            padding: 18px 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 22px;
            font-weight: bold;
            color: #63e6be;
        }

        .nav-links {
            display: flex;
            gap: 25px;
            list-style: none;
        }

        .nav-links a {
            color: #d7dee8;
            font-size: 14px;
            transition: 0.3s;
        }

        .nav-links a:hover {
            color: #63e6be;
        }

        /* HERO */

        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 120px 20px 70px;
            background:
                radial-gradient(circle at 20% 20%, rgba(99,230,190,0.12), transparent 30%),
                radial-gradient(circle at 80% 70%, rgba(56,189,248,0.10), transparent 30%);
        }

        .hero-content {
            max-width: 850px;
        }

        .hero-badge {
            display: inline-block;
            padding: 8px 16px;
            border: 1px solid rgba(99,230,190,0.4);
            border-radius: 30px;
            color: #63e6be;
            font-size: 14px;
            margin-bottom: 22px;
            background: rgba(99,230,190,0.05);
        }

        .hero h1 {
            font-size: clamp(45px, 8vw, 82px);
            line-height: 1;
            margin-bottom: 20px;
        }

        .hero h1 span {
            color: #63e6be;
        }

        .hero h2 {
            font-size: clamp(20px, 4vw, 32px);
            color: #b9c4d0;
            font-weight: 500;
            margin-bottom: 20px;
        }

        .hero p {
            max-width: 700px;
            margin: auto;
            color: #8f9bab;
            font-size: 17px;
        }

        .hero-buttons {
            margin-top: 35px;
            display: flex;
            justify-content: center;
            gap: 15px;
            flex-wrap: wrap;
        }

        .btn {
            padding: 13px 25px;
            border-radius: 8px;
            font-weight: bold;
            transition: 0.3s;
            display: inline-block;
        }

        .btn-primary {
            background: #63e6be;
            color: #07111f;
        }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(99,230,190,0.25);
        }

        .btn-outline {
            border: 1px solid #344255;
            color: white;
        }

        .btn-outline:hover {
            border-color: #63e6be;
            color: #63e6be;
            transform: translateY(-3px);
        }

        /* COMMON */

        section {
            padding: 90px 20px;
        }

        .container {
            max-width: 1100px;
            margin: auto;
        }

        .section-title {
            text-align: center;
            margin-bottom: 55px;
        }

        .section-title span {
            color: #63e6be;
            font-size: 14px;
            font-weight: bold;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .section-title h2 {
            font-size: 38px;
            margin-top: 8px;
        }

        /* ABOUT */

        .about-grid {
            display: grid;
            grid-template-columns: 1fr 1.5fr;
            gap: 50px;
            align-items: center;
        }

        .profile-card {
            padding: 35px;
            border: 1px solid #263448;
            border-radius: 18px;
            background: #0c1828;
            text-align: center;
        }

        .profile-icon {
            width: 120px;
            height: 120px;
            margin: auto auto 20px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 45px;
            font-weight: bold;
            background: linear-gradient(135deg, #63e6be, #38bdf8);
            color: #07111f;
        }

        .profile-card h3 {
            font-size: 22px;
        }

        .profile-card p {
            color: #8f9bab;
            margin-top: 5px;
        }

        .about-text p {
            color: #aeb8c5;
            margin-bottom: 18px;
        }

        .stats {
            display: flex;
            gap: 30px;
            margin-top: 30px;
            flex-wrap: wrap;
        }

        .stat strong {
            display: block;
            font-size: 27px;
            color: #63e6be;
        }

        .stat span {
            color: #7f8b9a;
            font-size: 13px;
        }

        /* SKILLS */

        .skills-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 18px;
        }

        .skill-card {
            padding: 25px;
            border: 1px solid #263448;
            border-radius: 14px;
            background: #0c1828;
            transition: 0.3s;
        }

        .skill-card:hover {
            transform: translateY(-5px);
            border-color: #63e6be;
        }

        .skill-card h3 {
            margin-bottom: 12px;
            color: #63e6be;
        }

        .skill-card p {
            color: #9da9b7;
            font-size: 14px;
        }

        /* PROJECTS */

        .projects-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 22px;
        }

        .project-card {
            position: relative;
            padding: 28px;
            border: 1px solid #263448;
            border-radius: 16px;
            background: #0c1828;
            overflow: hidden;
            transition: 0.3s;
        }

        .project-card:hover {
            transform: translateY(-8px);
            border-color: #63e6be;
            box-shadow: 0 15px 40px rgba(0,0,0,0.25);
        }

        .project-number {
            color: #63e6be;
            font-size: 13px;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .project-card h3 {
            font-size: 22px;
            margin-bottom: 8px;
        }

        .project-card .subtitle {
            color: #63e6be;
            font-size: 13px;
            margin-bottom: 15px;
        }

        .project-card p {
            color: #9da9b7;
            font-size: 14px;
            margin-bottom: 20px;
        }

        .tags {
            display: flex;
            gap: 7px;
            flex-wrap: wrap;
        }

        .tag {
            padding: 5px 9px;
            background: #152437;
            border-radius: 5px;
            color: #aebbc9;
            font-size: 11px;
        }

        /* CERTIFICATIONS */

        .cert-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
        }

        .cert-card {
            padding: 22px;
            background: #0c1828;
            border: 1px solid #263448;
            border-radius: 12px;
            color: #c8d1dc;
        }

        .cert-card::before {
            content: "✓";
            color: #63e6be;
            font-weight: bold;
            margin-right: 10px;
        }

        /* EDUCATION */

        .education-card {
            max-width: 800px;
            margin: auto;
            padding: 35px;
            background: #0c1828;
            border: 1px solid #263448;
            border-radius: 16px;
        }

