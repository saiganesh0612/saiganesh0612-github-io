<style>
  :root{
    --bg: #10151f;
    --surface: #161d2a;
    --surface-alt: #1b2434;
    --line: #2a3348;
    --text: #e9ecf2;
    --text-muted: #8d99ad;
    --amber: #e7a33e;
    --amber-soft: rgba(231,163,62,0.14);
    --teal: #49c9b8;
    --teal-soft: rgba(73,201,184,0.14);
    --max: 760px;
  }

  *{ box-sizing: border-box; }
  html{ scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce){
    html{ scroll-behavior: auto; }
    *{ animation-duration: 0.001ms !important; animation-iteration-count: 1 !important; transition-duration: 0.001ms !important; }
  }

  body{
    margin:0;
    background: var(--bg);
    color: var(--text);
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 16px;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }

  a{ color: inherit; }

  ::selection{ background: var(--amber); color: #10151f; }

  h1,h2,h3{
    font-family: 'Fraunces', serif;
    font-weight: 500;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .wrap{
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 28px;
  }

  /* progress rail */
  #rail{
    position: fixed;
    top: 0; left: 0;
    width: 3px; height: 100%;
    background: transparent;
    z-index: 50;
  }
  #rail-fill{
    width: 100%; height: 0%;
    background: linear-gradient(180deg, var(--teal), var(--amber));
    transition: height 0.08s linear;
  }

  /* ---------- HERO ---------- */
  .hero{
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }
  #net{
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    opacity: 0.55;
    mask-image: radial-gradient(ellipse 80% 80% at 65% 40%, black 40%, transparent 85%);
  }
  .hero-inner{
    position: relative;
    z-index: 2;
    max-width: var(--max);
    margin: 0 auto;
    padding: 120px 28px 100px;
    width: 100%;
  }
  .kicker{
    font-family: 'IBM Plex Mono', monospace;
    font-size: 13px;
    color: var(--teal);
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 22px;
    opacity: 0;
    animation: rise 0.7s ease forwards 0.1s;
  }
  .kicker .dot{
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--teal);
    box-shadow: 0 0 0 0 rgba(73,201,184,0.5);
    animation: pulse-dot 2.4s ease-in-out infinite;
  }
  h1.name{
    font-size: clamp(2.6rem, 7vw, 4.4rem);
    line-height: 1.02;
    display: flex;
    flex-wrap: wrap;
  }
  h1.name .letter{
    display: inline-block;
    opacity: 0;
    transform: translateY(0.4em);
    animation: rise 0.65s cubic-bezier(.2,.7,.2,1) forwards;
  }
  .role{
    font-family: 'IBM Plex Mono', monospace;
    font-size: clamp(0.95rem, 2vw, 1.05rem);
    color: var(--text-muted);
    margin-top: 20px;
    opacity: 0;
    animation: rise 0.7s ease forwards 1.05s;
  }
  .role .sep{ color: var(--line); margin: 0 10px; }
  .contact-row{
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    opacity: 0;
    animation: rise 0.7s ease forwards 1.25s;
  }
  .contact-row a, .contact-row span{
    font-size: 13.5px;
    color: var(--text-muted);
    border: 1px solid var(--line);
    padding: 7px 13px;
    border-radius: 100px;
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
  }
  .contact-row a:hover{
    border-color: var(--amber);
    color: var(--amber);
    background: var(--amber-soft);
  }

  @keyframes rise{
    to{ opacity: 1; transform: translateY(0); }
  }
  @keyframes pulse-dot{
    0%,100%{ box-shadow: 0 0 0 0 rgba(73,201,184,0.45); }
    50%{ box-shadow: 0 0 0 6px rgba(73,201,184,0); }
  }

  .scroll-cue{
    position: absolute;
    bottom: 34px; left: 28px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 10px;
    z-index: 2;
  }
  .scroll-cue::before{
    content: '';
    width: 1px; height: 26px;
    background: var(--line);
    position: relative;
    overflow: hidden;
    display: block;
  }
  .scroll-cue::after{
    content: '';
    position: absolute;
    left: 28px;
    width: 1px; height: 10px;
    background: var(--amber);
    animation: cue 1.8s ease-in-out infinite;
  }
  @keyframes cue{
    0%{ transform: translateY(0); opacity: 0; }
    30%{ opacity: 1; }
    100%{ transform: translateY(24px); opacity: 0; }
  }

  /* ---------- SECTIONS ---------- */
  section{
    padding: 96px 0;
    border-bottom: 1px solid var(--line);
  }
  section:last-of-type{ border-bottom: none; }

  .section-head{
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 40px;
  }
  .section-head .idx{
    font-family: 'IBM Plex Mono', monospace;
    font-size: 13px;
    color: var(--amber);
  }
  .section-head h2{
    font-size: clamp(1.6rem, 4vw, 2.1rem);
  }

  .reveal{
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  .reveal.in{
    opacity: 1;
    transform: translateY(0);
  }

  /* About */
  #about p{
    font-size: 1.08rem;
    color: #cfd6e2;
    max-width: 64ch;
  }

  /* Skills */
  .skill-group{
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 18px 24px;
    padding: 16px 0;
    border-top: 1px solid var(--line);
  }
  .skill-group:last-child{ border-bottom: 1px solid var(--line); }
  .skill-group .label{
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12.5px;
    color: var(--text-muted);
    padding-top: 3px;
  }
  .tags{
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tag{
    font-size: 13.5px;
    padding: 6px 12px;
    border-radius: 7px;
    background: var(--surface);
    border: 1px solid var(--line);
    opacity: 0;
    transform: scale(0.92);
    transition: opacity 0.45s ease, transform 0.45s ease, border-color 0.2s ease;
  }
  .tag.in{ opacity: 1; transform: scale(1); }
  .tag:hover{ border-color: var(--teal); }

  @media (max-width: 560px){
    .skill-group{ grid-template-columns: 1fr; gap: 8px; }
  }

  /* Projects */
  .project{
    position: relative;
    padding: 40px 0 40px 54px;
    border-top: 1px solid var(--line);
  }
  .project:last-child{ border-bottom: 1px solid var(--line); }
  .node{
    position: absolute;
    left: 0; top: 44px;
    width: 38px; height: 38px;
    border-radius: 50%;
    background: var(--surface);
    border: 1px solid var(--line);
    display: flex; align-items: center; justify-content: center;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10.5px;
    color: var(--amber);
    z-index: 2;
  }
  .node-line{
    position: absolute;
    left: 19px; top: 82px;
    width: 1px;
    height: calc(100% - 40px);
    background: var(--line);
    overflow: hidden;
  }
  .node-line::after{
    content:'';
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 0%;
    background: linear-gradient(180deg, var(--teal), var(--amber));
    transition: height 1.1s cubic-bezier(.2,.7,.2,1);
  }
  .project.in .node-line::after{ height: 100%; }
  .project:last-child .node-line{ display: none; }
  .project.in .node{ border-color: var(--amber); }

  .project h3{
    font-size: 1.28rem;
    display: inline;
  }
  .project .tagline{
    display: block;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12.5px;
    color: var(--teal);
    margin-top: 6px;
  }
  .project ul{
    margin: 18px 0 0;
    padding-left: 18px;
    color: #c3cbda;
  }
  .project li{ margin-bottom: 8px; }
  .project li::marker{ color: var(--text-muted); }

  /* Certifications */
  .cert-list{ list-style: none; margin: 0; padding: 0; }
  .cert-list li{
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 0;
    border-top: 1px solid var(--line);
    font-size: 15px;
  }
  .cert-list li:last-child{ border-bottom: 1px solid var(--line); }
  .cert-list .mark{
    width: 20px; height: 20px;
    border-radius: 50%;
    border: 1px solid var(--teal);
    flex-shrink: 0;
    position: relative;
  }
  .cert-list .mark::after{
    content:'';
    position: absolute;
    left: 6px; top: 3px;
    width: 5px; height: 9px;
    border-right: 2px solid var(--teal);
    border-bottom: 2px solid var(--teal);
    transform: rotate(45deg) scale(0);
    transition: transform 0.4s cubic-bezier(.2,.7,.2,1);
  }
  .cert-list li.in .mark::after{ transform: rotate(45deg) scale(1); }

  /* Education */
  .edu-card{
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 28px 30px;
  }
  .edu-card h3{ font-size: 1.2rem; }
  .edu-card .school{ color: var(--text-muted); margin-top: 8px; font-size: 14.5px; }
  .edu-card .meta{
    margin-top: 18px;
    display: flex;
    gap: 22px;
    flex-wrap: wrap;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12.5px;
    color: var(--amber);
  }

  /* Achievements + Languages */
  .two-col{
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 48px;
  }
  @media (max-width: 640px){
    .two-col{ grid-template-columns: 1fr; gap: 36px; }
  }
  .achieve-list{ list-style: none; margin: 0; padding: 0; }
  .achieve-list li{
    padding: 12px 0;
    border-top: 1px solid var(--line);
    color: #c3cbda;
    font-size: 14.5px;
    padding-left: 18px;
    position: relative;
  }
  .achieve-list li::before{
    content:'';
    position: absolute;
    left: 0; top: 20px;
    width: 6px; height: 1px;
    background: var(--amber);
  }
  .lang-row{
    display: flex;
    justify-content: space-between;
    padding: 12px 0;
    border-top: 1px solid var(--line);
    font-size: 14.5px;
  }
  .lang-row span:last-child{ color: var(--text-muted); font-family: 'IBM Plex Mono', monospace; font-size: 12.5px; }

  /* Footer */
  footer{
    padding: 80px 0 60px;
    text-align: left;
  }
  footer h2{
    font-size: clamp(1.8rem, 5vw, 2.6rem);
    max-width: 14ch;
  }
  .footer-links{
    margin-top: 34px;
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .btn{
    font-family: 'IBM Plex Mono', monospace;
    font-size: 13.5px;
    padding: 12px 20px;
    border-radius: 8px;
    text-decoration: none;
    border: 1px solid var(--line);
    transition: border-color 0.2s ease, background 0.2s ease, color 0.2s ease;
  }
  .btn.primary{
    background: var(--amber);
    color: #1a1305;
    border-color: var(--amber);
  }
  .btn.primary:hover{ background: #f3b559; }
  .btn.ghost:hover{ border-color: var(--teal); color: var(--teal); }
  footer .fine{
    margin-top: 60px;
    font-size: 12.5px;
    color: var(--text-muted);
  }

  a:focus-visible, button:focus-visible{
    outline: 2px solid var(--teal);
    outline-offset: 3px;
  }
</style>
</head>
