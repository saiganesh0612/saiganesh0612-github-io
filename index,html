            color: #63e6be;
            font-size: 22px;
        }

        .education-card p {
            color: #9da9b7;
            margin-top: 8px;
        }

        /* CONTACT */

        .contact-box {
            max-width: 800px;
            margin: auto;
            text-align: center;
            padding: 50px 25px;
            border-radius: 20px;
            background: linear-gradient(
                135deg,
                rgba(99,230,190,0.08),
                rgba(56,189,248,0.05)
