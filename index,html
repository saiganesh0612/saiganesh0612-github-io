<script>
/* ---------------- data (from resume) ---------------- */
const skillGroups = [
  { label: 'Languages', items: ['Python','C','C++','Java'] },
  { label: 'AI / ML', items: ['TensorFlow','Keras','Neural Networks','Data Analysis','Model Training & Evaluation'] },
  { label: 'Cloud', items: ['AWS Cloud Fundamentals (Cloud Practitioner Essentials)'] },
  { label: 'Development', items: ['App Development','Web Technologies','REST-style integrations'] },
  { label: 'Tools', items: ['Google AI Studio','GitHub','Jupyter Notebook'] },
  { label: 'Core CS', items: ['Data Structures','Object-Oriented Programming','Problem Solving'] },
];

const projects = [
  {
    node: 'AF',
    title: 'AI Farm Advisor',
    tagline: 'AI-powered agriculture support platform',
    bullets: [
      'Designed an AI-driven agricultural guidance platform connecting farmers with specialists, workers, tractor owners, and crop buyers',
      'Implemented phone number OTP login and role-based services for farmers, workers, tractor operators, and specialists',
      'Built direct crop-selling support and real-time work documentation/status updates',
      'Added a call-support channel to make the platform accessible to farmers unable to use the app directly',
    ]
  },
  {
    node: 'S2L',
    title: 'See2Learn',
    tagline: 'Real-World Object to AR Concept Visualization System',
    bullets: [
      'Built an educational technology concept that uses AI-based object recognition to identify real-world objects',
      'Used Augmented Reality to turn recognized objects into interactive, experiential learning content',
      'Focused on translating abstract concepts into hands-on, visual learning experiences for students',
    ]
  },
  {
    node: 'ES',
    title: 'EcoSkin: Self-Healing Road',
    tagline: 'Sustainable smart-infrastructure concept',
    bullets: [
      'Proposed a road infrastructure concept using self-healing materials to reduce maintenance and extend road life',
      'Designed embedded sensor integration for continuous road-condition monitoring',
      'Applied AI-based predictive analysis to anticipate wear and flag maintenance needs proactively',
    ]
  },
];

const certs = [
  'AWS Cloud Practitioner Essentials',
  'Generative AI Developer Learning',
  'Machine Learning and Neural Networks using TensorFlow/Keras',
  'AI and Data Analysis Fundamentals',
];

const achievements = [
  'Participated in innovation and sustainability-focused technology projects',
  'Built and explored multiple AI-based real-world solution prototypes',
  'Completed programming and machine learning coursework and assignments',
  'Actively developing skills in AI, Cloud Computing, and Software Development',
];

const languages = [
  { name: 'Tamil', level: 'Native' },
  { name: 'English', level: 'Professional Working Proficiency' },
];

/* ---------------- render ---------------- */
const skillWrap = document.getElementById('skill-groups');
skillGroups.forEach(g => {
  const row = document.createElement('div');
  row.className = 'skill-group';
  row.innerHTML = `<div class="label">${g.label}</div><div class="tags">${g.items.map(i=>`<span class="tag">${i}</span>`).join('')}</div>`;
  skillWrap.appendChild(row);
});

const projWrap = document.getElementById('project-list');
projects.forEach(p => {
  const row = document.createElement('div');
  row.className = 'project';
  row.innerHTML = `
    <div class="node">${p.node}</div>
    <div class="node-line"></div>
    <h3>${p.title}</h3>
    <span class="tagline">${p.tagline}</span>
    <ul>${p.bullets.map(b=>`<li>${b}</li>`).join('')}</ul>
  `;
  projWrap.appendChild(row);
});

const certWrap = document.getElementById('cert-list');
certs.forEach(c => {
  const li = document.createElement('li');
  li.innerHTML = `<span class="mark"></span><span>${c}</span>`;
  certWrap.appendChild(li);
});

const achWrap = document.getElementById('achieve-list');
achievements.forEach(a => {
  const li = document.createElement('li');
  li.textContent = a;
  achWrap.appendChild(li);
});

const langWrap = document.getElementById('lang-list');
languages.forEach(l => {
  const row = document.createElement('div');
  row.className = 'lang-row';
  row.innerHTML = `<span>${l.name}</span><span>${l.level}</span>`;
  langWrap.appendChild(row);
});

/* ---------------- hero name letter reveal ---------------- */
const nameEl = document.getElementById('name-target');
const nameText = nameEl.textContent;
nameEl.textContent = '';
[...nameText].forEach((ch, i) => {
  const span = document.createElement('span');
  span.className = 'letter';
  span.style.animationDelay = (0.15 + i * 0.045) + 's';
  span.textContent = ch === ' ' ? '\u00A0' : ch;
  nameEl.appendChild(span);
});

/* ---------------- scroll reveal ---------------- */
const revealEls = document.querySelectorAll('.reveal, .project, .cert-list li');
const io = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      entry.target.classList.add('in');
      io.unobserve(entry.target);
    }
  });
}, { threshold: 0.18 });
revealEls.forEach(el => io.observe(el));

const tagEls = document.querySelectorAll('.tag');
const tagIo = new IntersectionObserver((entries) => {
  entries.forEach((entry, i) => {
    if (entry.isIntersecting) {
      const idx = [...tagEls].indexOf(entry.target);
      setTimeout(() => entry.target.classList.add('in'), (idx % 12) * 30);
      tagIo.unobserve(entry.target);
    }
  });
}, { threshold: 0.4 });
tagEls.forEach(el => tagIo.observe(el));

/* ---------------- scroll progress rail ---------------- */
const railFill = document.getElementById('rail-fill');
window.addEventListener('scroll', () => {
  const h = document.documentElement;
  const pct = (h.scrollTop) / (h.scrollHeight - h.clientHeight) * 100;
  railFill.style.height = pct + '%';
}, { passive: true });

/* ---------------- hero neural network canvas ---------------- */
const canvas = document.getElementById('net');
const ctx = canvas.getContext('2d');
const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
let w, h, nodes = [];
const NODE_COUNT = 46;
const LINK_DIST = 140;

function resize(){
  w = canvas.width = canvas.parentElement.offsetWidth * devicePixelRatio;
  h = canvas.height = canvas.parentElement.offsetHeight * devicePixelRatio;
  canvas.style.width = canvas.parentElement.offsetWidth + 'px';
  canvas.style.height = canvas.parentElement.offsetHeight + 'px';
}
function initNodes(){
  nodes = Array.from({length: NODE_COUNT}, () => ({
    x: Math.random() * w,
    y: Math.random() * h,
    vx: (Math.random() - 0.5) * 0.25 * devicePixelRatio,
    vy: (Math.random() - 0.5) * 0.25 * devicePixelRatio,
    r: (Math.random() * 1.6 + 1.2) * devicePixelRatio,
  }));
}
function step(){
  ctx.clearRect(0, 0, w, h);
  nodes.forEach(n => {
    n.x += n.vx; n.y += n.vy;
    if (n.x < 0 || n.x > w) n.vx *= -1;
    if (n.y < 0 || n.y > h) n.vy *= -1;
  });
  for (let i = 0; i < nodes.length; i++){
    for (let j = i + 1; j < nodes.length; j++){
      const a = nodes[i], b = nodes[j];
      const dx = a.x - b.x, dy = a.y - b.y;
      const dist = Math.sqrt(dx*dx + dy*dy);
      const maxDist = LINK_DIST * devicePixelRatio;
      if (dist < maxDist){
        const op = (1 - dist / maxDist) * 0.5;
        ctx.strokeStyle = `rgba(73,201,184,${op})`;
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(a.x, a.y);
        ctx.lineTo(b.x, b.y);
        ctx.stroke();
      }
    }
  }
  nodes.forEach(n => {
    ctx.beginPath();
    ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
    ctx.fillStyle = 'rgba(231,163,62,0.85)';
    ctx.fill();
  });
  if (!reduceMotion) requestAnimationFrame(step);
}
resize();
initNodes();
step();
window.addEventListener('resize', () => { resize(); initNodes(); });
</script>
</body>
</html>


