            padding: 30px 20px;
            text-align: center;
            color: #6f7c8c;
            font-size: 13px;
        }

        /* ANIMATION */

        .fade-up {
            animation: fadeUp 1s ease forwards;
        }

        @keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(25px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* MOBILE */

        @media (max-width: 850px) {

            .nav-links {
                display: none;
            }

            .about-grid {
                grid-template-columns: 1fr;
            }

            .skills-grid,
            .projects-grid {
                grid-template-columns: 1fr;
            }

            .cert-grid {
                grid-template-columns: 1fr;
            }

            .hero h1 {
                font-size: 52px;
            }

            section {
                padding: 70px 18px;
            }
        }

        @media (max-width: 500px) {

            .hero h1 {
                font-size: 43px;
            }

            .hero h2 {
                font-size: 20px;
            }

            .section-title h2 {
                font-size: 30px;
            }

            .stats {
                justify-content: center;
            }
        }
    </style>
</head>

